# Server-side only. Use the PostgreSQL connection string from your Supabase project.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
PG_SSL=true
PG_POOL_MAX=10

# Comma-separated exact browser origins. Keep the existing local frontend.
FRONTEND_ORIGINS=http://localhost:3001
PORT=3000
HOST=127.0.0.1

# Optional Overpass endpoint override; public OpenStreetMap Overpass API is used by default.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
